# Copy to .env — never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=
YOUTUBE_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
APP_BASE_URL=http://localhost:8000
COMPETITOR_INTEL_BROWSER=auto
# Semantic matching: set to off to skip the optional embedding model, or choose another model
SEMANTIC_EMBEDDINGS=auto
# SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: route ONLY requests that a site blocked through a proxy (e.g. http://user:pass@proxy.example.com:8080).
# Useful when sites refuse cloud servers (HTTP 403). Paid third-party service; use it only on sites you are allowed to read.
SCRAPER_PROXY_URL=
