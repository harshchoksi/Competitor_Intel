# Copy to .env (never commit it). Everything is optional; the site works without any of these.

# AI summary (free key from Google AI Studio). Model names change; override if needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# YouTube channel stats (free key from Google Cloud Console > YouTube Data API v3)
YOUTUBE_API_KEY=

# Email alerts for monitors
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram alerts (create a bot with @BotFather, then send it a message and use your chat id)
TELEGRAM_BOT_TOKEN=

# Used for the link inside alert messages, e.g. http://localhost:8000
APP_BASE_URL=

# Browser fallback for JavaScript-rendered sites: auto | on | off
COMPETITOR_INTEL_BROWSER=auto
